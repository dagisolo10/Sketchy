{
    "name": "Sketchy",
    "private": true,
    "scripts": {
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "build": "turbo run build",
        "format": "prettier --write .",
        "check-types": "turbo run check-types"
    },
    "devDependencies": {
        "prettier": "3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "turbo": "^2.11.6",
        "typescript": "7.0.2"
    },
    "engines": {
        "node": ">=24"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.4.0"
        }
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ]
}
